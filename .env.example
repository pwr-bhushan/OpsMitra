# =============================================================================
# OpsMitra environment template
# =============================================================================
#
# 1. Copy this file:    cp .env.example .env
# 2. Edit `.env` with your real values (NEVER commit `.env`).
# 3. Source before invoking:  set -a; source .env; set +a
# 4. Verify with the preflight:  .venv/bin/python -m opsmitra validate
#
# `.env` is gitignored. `.env.example` is committed and acts as the canonical
# reference for every `OPSMITRA_*` variable the project understands. Defaults
# shown in comments match the values in `src/opsmitra/config.py`.
#
# Conventions:
#   #   REQUIRED      => must be set when the mode is active (validate errors)
#   #   OPTIONAL      => safe to omit; default applies
#   #   CONDITIONAL   => required only when a sibling var is set; see comment
# =============================================================================


# -----------------------------------------------------------------------------
# Model summarizer (Step 5)
# -----------------------------------------------------------------------------
# Provider switch. `fallback` uses the deterministic in-process summarizer and
# ignores every other OPSMITRA_MODEL_* var. `ollama` (or any non-`fallback`
# value) activates the HTTP client at OPSMITRA_MODEL_URL.
# OPTIONAL  default: fallback
OPSMITRA_MODEL_PROVIDER=fallback

# OPTIONAL  default: http://localhost:11434  (only used when provider != fallback)
# OPSMITRA_MODEL_URL=http://localhost:11434

# OPTIONAL  default: llama3.1:8b
# OPSMITRA_MODEL_NAME=llama3.1:8b

# OPTIONAL  default: 10  (seconds; bound > 0)
# OPSMITRA_MODEL_TIMEOUT=10


# -----------------------------------------------------------------------------
# Slack alert delivery (Step 6)
# -----------------------------------------------------------------------------
# Keep TRUE during development; setting FALSE flips the runtime to live send
# mode and makes OPSMITRA_SLACK_WEBHOOK_URL REQUIRED.
# OPTIONAL  default: true
OPSMITRA_DRY_RUN=true

# CONDITIONAL  required when OPSMITRA_DRY_RUN=false.
# NEVER commit this value. The validator reports it as set/unset only — its
# value never reaches any log or rendered output.
# OPSMITRA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOURS

# OPTIONAL tuning knobs. Defaults are sane for local dev and CI.
# OPSMITRA_SLACK_TIMEOUT_SECONDS=5.0
# OPSMITRA_SLACK_MAX_RETRIES=3
# OPSMITRA_SLACK_BACKOFF_BASE_SECONDS=0.5
# OPSMITRA_SLACK_BACKOFF_MAX_SECONDS=8.0
# OPSMITRA_SLACK_TOTAL_WAIT_CAP_SECONDS=15.0

# OPTIONAL  default: unset (Slack uses the webhook's default channel)
# OPSMITRA_SLACK_CHANNEL_OVERRIDE=#oncall


# -----------------------------------------------------------------------------
# Event source + sink (Step 7)
# -----------------------------------------------------------------------------
# `local` reads/writes NDJSON files; `athena` / `s3` activate the AWS paths
# (boto3 isolated under opsmitra.aws.*).
# OPTIONAL  default: local      choices: local | athena
OPSMITRA_EVENT_SOURCE=local

# OPTIONAL  default: local      choices: local | s3
OPSMITRA_EVENT_SINK=local

# OPTIONAL  default: us-east-1
# OPSMITRA_AWS_REGION=us-east-1

# CONDITIONAL  required when OPSMITRA_EVENT_SINK=s3
# OPSMITRA_S3_BUCKET=my-opsmitra-events

# OPTIONAL  default: opsmitra-events
# OPSMITRA_S3_PREFIX=opsmitra-events

# OPTIONAL  default: opsmitra
# OPSMITRA_ATHENA_DATABASE=opsmitra

# OPTIONAL  default: events
# OPSMITRA_ATHENA_TABLE=events

# OPTIONAL  default: primary
# OPSMITRA_ATHENA_WORKGROUP=primary

# CONDITIONAL  required when OPSMITRA_EVENT_SOURCE=athena. Must be an
# s3://bucket/prefix/ where Athena can write query results.
# OPSMITRA_ATHENA_OUTPUT_LOCATION=s3://my-athena-output/results/

# OPTIONAL  default: unset (use DetectorThresholds defaults). 1 MB file cap.
# OPSMITRA_THRESHOLDS_PATH=./thresholds.json


# -----------------------------------------------------------------------------
# Runtime: cooldown + safety caps (Step 8)
# -----------------------------------------------------------------------------
# Anomaly fingerprint cooldown window in seconds. 0 = never suppress.
# OPTIONAL  default: 3600  (bound >= 0)
# OPSMITRA_COOLDOWN_SECONDS=3600

# JSON file backing the cooldown store. fcntl-locked on a sibling `<path>.lock`.
# OPTIONAL  default: ./.opsmitra/cooldown.json
# OPSMITRA_COOLDOWN_PATH=./.opsmitra/cooldown.json

# Hard cap on events fetched per run window (Athena cost guard).
# OPTIONAL  default: 1000000  (bound > 0)
# OPSMITRA_MAX_EVENTS_PER_WINDOW=1000000


# -----------------------------------------------------------------------------
# Local file paths (always honored; ignored when AWS source/sink is active)
# -----------------------------------------------------------------------------
# OPTIONAL  default: data/events.jsonl
# OPSMITRA_LOG_PATH=data/events.jsonl

# OPTIONAL  default: outputs
# OPSMITRA_OUTPUT_PATH=outputs


# =============================================================================
# AWS credentials (standard boto3 chain)
# =============================================================================
# OpsMitra does NOT define its own AWS-credential env vars. boto3 reads the
# standard chain: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN,
# AWS_PROFILE, or instance role / IRSA. Prefer instance role over static keys
# in production. See docs/security-checklist.md.
# =============================================================================
